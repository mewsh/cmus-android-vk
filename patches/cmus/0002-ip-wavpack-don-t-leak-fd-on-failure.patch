From d6bdbc26cb73d5f38c98df306017e4f744fe489a Mon Sep 17 00:00:00 2001
From: Patrick Gaskin <patrick@pgaskin.net>
Date: Wed, 23 Sep 2026 22:43:43 -0400
Subject: [PATCH 02/14] ip/wavpack: don't leak fd on failure


diff --git a/ip/wavpack.c b/ip/wavpack.c
index 02fa777..43ac5d6 100644
--- a/ip/wavpack.c
+++ b/ip/wavpack.c
@@ -203,7 +203,10 @@ static int wavpack_open(struct input_plugin_data *ip_data)
 
 	if (!priv->wpc) {
 		d_print("WavpackOpenFileInputEx failed: %s\n", msg);
+		if (priv->has_wvc)
+			close(priv->wvc_file.fd);
 		free(priv);
+		ip_data->private = NULL;
 		return -IP_ERROR_FILE_FORMAT;
 	}
 
